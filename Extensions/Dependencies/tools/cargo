#!/usr/bin/env python3
"""Wrapper for the historical iOS static-extension build."""
import os.path
import subprocess
import sys

cargo = os.path.expanduser("~/.cargo/bin/cargo")
original = sys.argv[1:]
args = ["staticlib" if arg == "cdylib" else arg for arg in original]
if args and args[0] == "rustc" and not any(
    arg == "--target" or arg.startswith("--target=") for arg in original
):
    args[1:1] = ["--target", "aarch64-apple-ios"]
cmd = [cargo] + args
print(cmd, file=sys.stderr)
sys.exit(subprocess.run(cmd).returncode)
